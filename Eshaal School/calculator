import tkinter as tk

def calculate_bmi():
    weight = float(weight entry.get())
    height = float(height entry.get()) / 100
    bmi = weight / (height ** 2)
    
    if bmi < 18.5:
        print("Underweight")
elif bmi < 25:
    status = 'Healthy'
    color = '#2ECC71'
elif bmi < 30:
    status = 'overweight'
    color = '#E67E22'
else:
    status = 'obese'
    color = '#E74C3C'

result_label.config(
    text=f'BMI:{bmi:.1f}-{status}',
    fg=color
)
window = tk.Tk()
window.title("BMI Calculator")
window.geometry('350x300')
window.configure(bg='#EBF5FB')

tk.Label(
    window,
    text="BMI Calculator",
    font=('Arial', 18, 'bold'),
    bg='#EBF5FB'
).pack(pady=10)
tk.Label(
    window,
    text="weight(kg)",
    font=('Arial', 13),
    bg='#EBF5FB'
).pack(pady=10)
weight_entry = tk.Entry(
    window,
    font=('Arial', 13),
    width=12,
    justify='center'
) 
weight_entry.pack(pady=4)
tk.Label(
    window,
    text="Height(cm)",
